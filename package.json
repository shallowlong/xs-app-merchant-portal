  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "npm run check:spec && npm run check:skill && npm run check:deps && npm run check:kb",
    "check:spec": "node ci/check-spec-refs.cjs",
    "check:skill": "node ci/check-skill-sync.cjs",
    "check:skill:sync": "node ci/check-skill-sync.cjs --sync",
    "check:deps": "node ci/check-require-decls.cjs --test-dir=src",
    "check:kb": "python ci/check-knowledge-facts.py",
    "check:commit": "node ci/check-commit-msg.cjs",
    "check:links": "node scripts/check-links.mjs",
    "check:links:write": "node scripts/check-links.mjs --write"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
